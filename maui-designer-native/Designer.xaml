<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:MAUIDesigner.HelperViews"
             x:Class="MAUIDesigner.Designer"
             Title="MAUI Designer Native"
             BackgroundColor="{StaticResource DesignerChrome}">
    <AbsoluteLayout>
        <Grid x:Name="MainGrid"
              AbsoluteLayout.LayoutBounds="0,0,1,1"
              AbsoluteLayout.LayoutFlags="All"
              RowDefinitions="48,*,160"
              ColumnDefinitions="220,*,340"
              BackgroundColor="{StaticResource DesignerChrome}">

            <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                    BackgroundColor="{StaticResource DesignerTitleBar}"
                    StrokeThickness="0"
                    Padding="16,0">
                <Grid ColumnDefinitions="*,Auto">
                    <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                        <BoxView WidthRequest="4" HeightRequest="22" Color="{StaticResource DesignerAccent}" CornerRadius="2"/>
                        <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                            <Label Text="MAUI Designer Native"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="16"
                                   TextColor="{StaticResource DesignerText}"/>
                            <Label Text="Live MAUI views · not an HTML approximation"
                                   FontSize="11"
                                   TextColor="{StaticResource DesignerMuted}"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                    <Label Grid.Column="1"
                           Text="WYSIWYG"
                           FontSize="11"
                           FontFamily="OpenSansSemibold"
                           TextColor="{StaticResource DesignerAccent}"
                           VerticalOptions="Center"
                           Padding="10,4"
                           BackgroundColor="{StaticResource DesignerAccentSoft}"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Grid.Column="0" ColumnDefinitions="*,6">
                <Border Stroke="{StaticResource DesignerBorder}" StrokeThickness="1"
                        BackgroundColor="{StaticResource DesignerPanel}" Padding="0">
                    <views:TabMenuHolder x:Name="LeftTabMenuHolder" IsSidebar="True"/>
                </Border>
                <BoxView x:Name="TabDraggerLeft" StyleId="TabDraggerLeft"
                         Grid.Column="1" Color="{StaticResource DesignerSplitter}" WidthRequest="6"/>
            </Grid>

            <Border Grid.Row="1" Grid.Column="1"
                    Margin="10,8"
                    Stroke="{StaticResource DesignerBorder}"
                    StrokeThickness="1"
                    BackgroundColor="{StaticResource DesignerCanvas}"
                    Padding="0">
                <AbsoluteLayout x:Name="designerFrame" BackgroundColor="{StaticResource DesignerCanvas}">
                    <AbsoluteLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" Buttons="Secondary,Primary"/>
                    </AbsoluteLayout.GestureRecognizers>
                </AbsoluteLayout>
            </Border>

            <Grid Grid.Row="1" Grid.Column="2" ColumnDefinitions="6,*">
                <BoxView x:Name="TabDraggerRight" StyleId="TabDraggerRight"
                         Color="{StaticResource DesignerSplitter}" WidthRequest="6"/>
                <Border Grid.Column="1" Stroke="{StaticResource DesignerBorder}" StrokeThickness="1"
                        BackgroundColor="{StaticResource DesignerPanel}">
                    <views:TabMenuHolder x:Name="RightTabMenuHolder"/>
                </Border>
            </Grid>

            <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" RowDefinitions="6,*">
                <BoxView x:Name="TabDraggerBottom" StyleId="TabDraggerBottom"
                         Color="{StaticResource DesignerSplitter}" HeightRequest="6"/>
                <Border Grid.Row="1" Stroke="{StaticResource DesignerBorder}" StrokeThickness="1"
                        BackgroundColor="{StaticResource DesignerPanel}">
                    <views:TabMenuHolder x:Name="BottomTabMenuHolder"/>
                </Border>
            </Grid>
        </Grid>

        <views:ContextMenu IsVisible="False" x:Name="contextMenu" ZIndex="10000"/>
    </AbsoluteLayout>
</ContentPage>
